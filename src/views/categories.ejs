<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <div>
            <ul>
                <%categories.forEach(category => {%>
                
                <li><strong><a href="/category/<%=category.category_id%>" ><%=category.category_name%></a></strong>: <%=category.category_description%></li>
            <%});%>
            </ul>
        
        </div>
        
        <span>
            <p><a href="/new-category">Create New Category</a></p>
        </span>
    </main>
    <%- include('partials/footer') %>