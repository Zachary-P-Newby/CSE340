<%- include('partials/header') %>
    <main>     <h1><%= title %></h1>
        <section class="category_details">
            <p><strong>Description:</strong> <%= category.category_description %></p>

            

            <div>
            <h2>Projects:</h2>
            <ul>

            <%projects.forEach(project => {%>
                <li><a href="/project/<%=project.project_id%>"><%=project.title%></a></li>
            <%});%>

            </ul>
            </div>
            <span>
                <p><a href="/edit-category/<%=category_id%>">Edit Category</a></p>
            </span>
            
        </section>
    </main>
<%- include('partials/footer') %>