<%- include('partials/header') %>
<main>
    <h1><%= projectDetails.title %></h1>

    <h2 class="assign-category-header">Assign Categories</h2>
 <form action="/assign-categories/<%=projectId%>" method="POST" id="category-select-form">
    <ul>
      <% categories.forEach(category => { %>
        <div class="">
          <input
            type="checkbox"
            id="category-<%= category.category_id %>"
            name="categoryIds"
            value="<%= category.category_id %>"
            class="category"
            <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
          />

          <label for="category-<%= category.category_id %>">
            <%= category.category_name %>
          </label>
        </div>
      <% }); %>
    </ul>
    <button type="submit">Update Categories</button>
  </form>
</main>
<%- include('partials/footer') %>