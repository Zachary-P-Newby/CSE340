<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>

        <!-- To get the desired organization from organizations, -->
        <!-- we subtract one from the desired id, as the organizations table starts at index 1, -->
        <!-- but the array containing organizations starts at index 0 -->
        <%projects.forEach(project => {%>
        
            <%const id_moved_to_zero_index = project.organization_id-1;%>
            <li><a href="/project/<%=project.project_id%>"><%=project.title%></a> - <a href="/organization/<%=project.organization_id%>"><%=organizations[id_moved_to_zero_index].organization_name%></a> - <%=project.project_date%></li>
        <%});%>
        
        </ul>

    </main>
    <%- include('partials/footer') %>