<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
        
        <%projects.forEach(project => {%>
            <%const id_moved_to_zero_index = project.organization_id-1;%>
            <li><a href="/project/<%=project.project_id%>"><%=project.title%></a> - <a href="/organization/<%=project.organization_id%>"><%=organizations[id_moved_to_zero_index].organization_name%></a></li>
        <%});%>
        
        </ul>

    </main>
    <%- include('partials/footer') %>