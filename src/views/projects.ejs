<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
        
        <%projects.forEach(project => {%>
            <%const id_moved_to_zero_index = project.organization_id-1;%>
            <li><strong><%=project.project_date%></strong>: <%=project.title%> (<%=organizations[id_moved_to_zero_index].organization_name%>)</li>
        <%});%>
        
        </ul>

    </main>
    <%- include('partials/footer') %>