<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    
 <form action="/login" method="POST">
    
    <div class=form-group>
        <label for="email">Email:</label>
        <input 
        type="email" 
        name="email" 
        id="email" 
        required/>
    </div>
    <div class=form-group>
        <label for ="password">Password:</label>
        <input
        type="password" 
        name="password" 
        id="password" 
        required/>
    </div>
    <div class=form-group>
    </div>
    <div class=form-group>
    <button type="submit">Log In</button>
    </div>
    
  </form>
</main>
<%- include('partials/footer') %>