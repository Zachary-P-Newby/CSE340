<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <div class="organizations-div">
        <p>Here are a few of our partner organizations:</p>
        <ul>
            <% organizations.forEach(organization => { %>
                <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organization_id %>"><%= organization.organization_name %></a>: <%= organization.contact_email %></li>
            <% }); %>
        </ul>
    </div>
    <span>
        <p><a href="/new-organization">Add a new organization</a></p>
    </span>
    
</main>
<%- include('partials/footer') %>